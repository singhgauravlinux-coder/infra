#!/usr/bin/env bash
# =============================================================================
# config/platform.env — single source of truth for the microsvc.store platform
# Edit this file before running; every phase script sources it via load_config.
# =============================================================================

# ---- Domain -----------------------------------------------------------------
export BASE_DOMAIN="microsvc.store"
export RANCHER_HOST="rancher.${BASE_DOMAIN}"
export ARGOCD_HOST="argocd.${BASE_DOMAIN}"
export GITLAB_HOST="gitlab.${BASE_DOMAIN}"
export HARBOR_HOST="harbor.${BASE_DOMAIN}"
export KEYCLOAK_HOST="auth.${BASE_DOMAIN}"
export GRAFANA_HOST="grafana.${BASE_DOMAIN}"
export SONARQUBE_HOST="sonar.${BASE_DOMAIN}"
export MINIO_CONSOLE_HOST="minio-console.${BASE_DOMAIN}"
export MINIO_API_HOST="minio.${BASE_DOMAIN}"
export INFISICAL_HOST="secrets.${BASE_DOMAIN}"

# ---- Let's Encrypt / cert-manager -------------------------------------------
export ACME_EMAIL="platform-admin@microsvc.store"
export DNS_PROVIDER="cloudflare"          # cloudflare | route53 | digitalocean ...
export CLOUDFLARE_API_TOKEN_SECRET_NAME="cloudflare-api-token"   # k8s secret, created out-of-band

# ---- Cluster sizing minimums (Phase 1 validation) ---------------------------
export MIN_CPU_CORES=8
export MIN_MEM_GB=32
export MIN_DISK_GB=200

# ---- Versions (pin explicitly; "latest stable" resolved once and pinned here
#      so re-runs are reproducible — update deliberately, not implicitly) -----
export K3S_CHANNEL="stable"
export HELM_VERSION="v3.16.4"
export CERT_MANAGER_VERSION="v1.16.2"
export TRAEFIK_CHART_VERSION="33.2.1"
export RANCHER_CHART_VERSION="2.10.1"
export EXTERNALDNS_CHART_VERSION="1.15.0"
export LONGHORN_CHART_VERSION="1.7.2"

# ---- Namespaces ---------------------------------------------------------------
export NS_CATTLE_SYSTEM="cattle-system"
export NS_KUBE_SYSTEM="kube-system"
export NS_CERT_MANAGER="cert-manager"
export NS_EXTERNAL_DNS="external-dns"
export NS_INGRESS="traefik"

# ---- Storage ------------------------------------------------------------------
export DEFAULT_STORAGE_CLASS="longhorn"
export STORAGE_REPLICA_COUNT=3

# ---- Behavior flags -----------------------------------------------------------
export NON_INTERACTIVE="${NON_INTERACTIVE:-true}"
export DEBUG="${DEBUG:-0}"

# =============================================================================
# Phase 3 — Platform Services
# =============================================================================
export NS_DATA="data"
export NS_SECURITY="security"
export NS_IDENTITY="identity"

export CNPG_OPERATOR_VERSION="0.23.1"          # CloudNativePG operator chart
export POSTGRES_IMAGE_TAG="16.4"
export POSTGRES_INSTANCES=3                    # 1 primary + 2 replicas
export REDIS_CHART_VERSION="20.6.2"            # bitnami/redis
export MINIO_OPERATOR_CHART_VERSION="6.0.4"
export MINIO_TENANT_CHART_VERSION="6.0.4"
export MINIO_TENANT_SERVERS=4
export MINIO_TENANT_VOLUMES_PER_SERVER=2
export MINIO_TENANT_VOLUME_SIZE="50Gi"
export INFISICAL_CHART_VERSION="1.4.0"
export EXTERNAL_SECRETS_CHART_VERSION="0.10.4"
export KEYCLOAK_CHART_VERSION="24.4.3"         # bitnami/keycloak

# =============================================================================
# Phase 4 — DevOps
# =============================================================================
export NS_DEVOPS="devops"
export HARBOR_CHART_VERSION="1.15.1"
export GITLAB_CHART_VERSION="8.5.2"
export GITLAB_RUNNER_CHART_VERSION="0.71.0"

# =============================================================================
# Phase 5 — GitOps
# =============================================================================
export NS_ARGOCD="argocd"
export ARGOCD_CHART_VERSION="7.7.11"
export ARGO_ROLLOUTS_CHART_VERSION="2.38.0"
export GITOPS_REPO_URL="https://${GITLAB_HOST}/platform/gitops-config.git"

# =============================================================================
# Phase 6 — Observability
# =============================================================================
export NS_OBSERVABILITY="observability"
export KUBE_PROM_STACK_CHART_VERSION="65.5.1"
export LOKI_CHART_VERSION="6.21.0"
export TEMPO_CHART_VERSION="1.15.1"
export OTEL_COLLECTOR_CHART_VERSION="0.108.0"
export METRICS_RETENTION_DAYS=15
export LOGS_RETENTION_DAYS=30

# =============================================================================
# Phase 7 — Quality & Security
# =============================================================================
export SONARQUBE_CHART_VERSION="10.6.1"
export KYVERNO_CHART_VERSION="3.3.3"
export COSIGN_VERSION="v2.4.1"
export SYFT_VERSION="v1.16.0"
export GRYPE_VERSION="v0.85.0"
export GITLEAKS_VERSION="v8.21.2"

# =============================================================================
# Phase 8 — Backup & DR
# =============================================================================
export NS_VELERO="velero"
export VELERO_CHART_VERSION="8.3.0"
export VELERO_PLUGIN_AWS_IMAGE="velero/velero-plugin-for-aws:v1.11.0"
export BACKUP_BUCKET="platform-velero-backups"
export BACKUP_SCHEDULE_CRON="0 2 * * *"          # daily 02:00
export BACKUP_TTL="360h"                          # 15 days
